# Environment Configuration for TopCV Backend
# Copy this file to .env and update with your actual values

# =============================================================================
# ASPNETCORE ENVIRONMENT
# =============================================================================
# Options: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Development

# =============================================================================
# SQL SERVER CONFIGURATION
# =============================================================================
# SQL Server SA password (must be strong: at least 8 characters with uppercase, lowercase, numbers, and symbols)
SA_PASSWORD=TopCv@2024!Strong

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# JWT Secret Key - MUST be at least 32 characters long
# IMPORTANT: Generate a new secure key for production!
# You can generate one with: openssl rand -base64 32
JWT_KEY=YOUR_SUPER_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG_FOR_PRODUCTION

# JWT Issuer
JWT_ISSUER=TopCV

# JWT Audience
JWT_AUDIENCE=TopCV.Client

# Access token expiration in minutes
JWT_ACCESS_TOKEN_MINUTES=30

# Refresh token expiration in days
JWT_REFRESH_TOKEN_DAYS=7

# =============================================================================
# NOTES
# =============================================================================
# 1. Never commit the .env file to version control
# 2. Keep .env.example updated with all required variables (without sensitive values)
# 3. For production, use a secrets management service (Azure Key Vault, AWS Secrets Manager, etc.)
# 4. Ensure SA_PASSWORD meets SQL Server password requirements
# 5. Generate a new JWT_KEY for each environment
